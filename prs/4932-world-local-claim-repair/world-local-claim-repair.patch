diff --git a/packages/world-local/src/storage/claim-owner.ts b/packages/world-local/src/storage/claim-owner.ts
new file mode 100644
index 000000000..341f2655c
--- /dev/null
+++ b/packages/world-local/src/storage/claim-owner.ts
@@ -0,0 +1,207 @@
+/**
+ * Owners of the step and wait claim files under `.locks/`.
+ *
+ * A step or wait change takes a claim with `writeExclusive` before it writes
+ * its entity and its event. A process that dies in between leaves the claim
+ * without the event. Every later write of that change loses the claim, so
+ * without a way to tell a dead writer from a working one, the event is never
+ * written and the run never advances.
+ *
+ * The claim therefore names its writer. A write that loses the claim and finds
+ * no event in the log takes the claim over only when that writer is known to be
+ * dead, or when the claim is older than {@link CLAIM_ABANDONED_AFTER_MS}.
+ */
+import { createHash, randomUUID } from 'node:crypto';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import { globalSingleton } from '@workflow/utils';
+import { write, writeExclusive } from '../fs.js';
+
+/**
+ * Age after which a claim with no event is abandoned even when its writer may
+ * still run (another host, another storage instance in this process, a pid in
+ * use again, or a claim written before claims named their writer). A writer
+ * takes milliseconds from its claim to its event, so this only decides how
+ * long a crashed run waits when its writer's death cannot be proven. It is the
+ * `stale` age of this World's lock files.
+ */
+export const CLAIM_ABANDONED_AFTER_MS = 30_000;
+
+interface ClaimOwner {
+  pid: number;
+  host: string;
+  /** Random per process, so a later process that reuses the pid differs. */
+  process: string;
+  /** Random per events storage instance. */
+  instance: string;
+}
+
+// Process-wide: every copy of this module in one process must agree on it.
+const identity = globalSingleton(
+  '@workflow/world-local//claim-owner',
+  1,
+  () => ({
+    process: randomUUID(),
+    host: os.hostname(),
+  })
+);
+
+/** A new id for one events storage instance. */
+export function newClaimInstanceId(): string {
+  return randomUUID();
+}
+
+/** The content of a claim file written by `instance` in this process. */
+export function claimOwnerContent(instance: string): string {
+  const owner: ClaimOwner = {
+    pid: process.pid,
+    host: identity.host,
+    process: identity.process,
+    instance,
+  };
+  return JSON.stringify(owner);
+}
+
+function parseClaimOwner(content: string): ClaimOwner | null {
+  try {
+    const value = JSON.parse(content);
+    if (
+      typeof value?.pid === 'number' &&
+      typeof value.host === 'string' &&
+      typeof value.process === 'string' &&
+      typeof value.instance === 'string'
+    ) {
+      return value;
+    }
+  } catch {
+    // An empty claim, from a version that did not name the writer.
+  }
+  return null;
+}
+
+/**
+ * Whether the claim's writer is known to be dead. False means it may still
+ * be working.
+ *
+ * The caller holds the per-step or per-wait in-process lock, so a claim this
+ * same instance wrote belongs to a call that has already ended.
+ */
+function isClaimOwnerDead(owner: ClaimOwner | null, instance: string): boolean {
+  if (!owner) return false;
+  if (owner.process === identity.process) {
+    return owner.instance === instance;
+  }
+  if (owner.host !== identity.host) return false;
+  // Another process with our pid can only be an earlier one, now dead.
+  if (owner.pid === process.pid) return true;
+  try {
+    process.kill(owner.pid, 0);
+    return false;
+  } catch (error) {
+    return (error as NodeJS.ErrnoException).code === 'ESRCH';
+  }
+}
+
+async function readClaim(
+  claimPath: string
+): Promise<{ content: string; stat: { ino: number; mtimeMs: number } } | null> {
+  let file: fs.FileHandle;
+  try {
+    file = await fs.open(claimPath, 'r');
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+  try {
+    // Content and stat from one open file, so they describe the same claim
+    // even if a takeover replaces it meanwhile.
+    const [content, stat] = await Promise.all([
+      file.readFile('utf8'),
+      file.stat(),
+    ]);
+    return { content, stat };
+  } finally {
+    await file.close();
+  }
+}
+
+/**
+ * Takes over the claim at `claimPath` for `instance` when the claim is
+ * abandoned and `isOrphaned` confirms its event is not in the log, and
+ * reports whether it did.
+ *
+ * False means the writer may still be working, the event was written, the
+ * claim is gone, or another writer took it over first: the caller refuses, as
+ * it did before this existed. `isOrphaned` (a scan of the run's log) runs only
+ * for an abandoned claim, so a claim with a live writer costs one small read.
+ */
+export async function takeOverAbandonedClaim(
+  claimPath: string,
+  instance: string,
+  isOrphaned: () => Promise<boolean>
+): Promise<boolean> {
+  return takeOver(claimPath, instance, isOrphaned, 0);
+}
+
+/**
+ * How many takers in a row, each dead before it rewrote what it took, a
+ * takeover looks past. Each one is a separate crash, so this is never reached
+ * in practice; it only bounds the recursion.
+ */
+const MAX_TAKEOVER_DEPTH = 8;
+
+async function takeOver(
+  claimPath: string,
+  instance: string,
+  isOrphaned: () => Promise<boolean>,
+  depth: number
+): Promise<boolean> {
+  const claim = await readClaim(claimPath);
+  if (!claim) return false;
+  const abandoned =
+    isClaimOwnerDead(parseClaimOwner(claim.content), instance) ||
+    Date.now() - claim.stat.mtimeMs >= CLAIM_ABANDONED_AFTER_MS;
+  if (!abandoned || !(await isOrphaned())) return false;
+  // One taker per abandoned claim. The marker is keyed by the claim as read,
+  // and the takeover replaces the claim (a new inode naming the taker), so a
+  // taker that dies after rewriting the claim leaves a claim with a new key.
+  // A taker that dies before rewriting it leaves its marker behind, so the
+  // marker names its taker too, and is taken over the same way.
+  const key = createHash('sha256')
+    .update(`${claim.stat.ino}:${claim.stat.mtimeMs}:${claim.content}`)
+    .digest('hex')
+    .slice(0, 16);
+  const marker = `${claimPath}.takeover.${key}`;
+  const won =
+    (await writeExclusive(marker, claimOwnerContent(instance))) ||
+    (depth < MAX_TAKEOVER_DEPTH &&
+      (await takeOver(marker, instance, async () => true, depth + 1)));
+  if (!won) return false;
+  // Only the marker's holder rewrites the claim. If the claim is no longer
+  // the one read above, an earlier taker already replaced it: back off.
+  const current = await readClaim(claimPath);
+  if (
+    !current ||
+    current.content !== claim.content ||
+    current.stat.ino !== claim.stat.ino ||
+    current.stat.mtimeMs !== claim.stat.mtimeMs
+  ) {
+    return false;
+  }
+  await write(claimPath, claimOwnerContent(instance), { overwrite: true });
+  return true;
+}
+
+/**
+ * Whether the claim at `claimPath` still names `instance` in this process.
+ * Checked before the claim's event is written, so a writer that was taken over
+ * as abandoned does not write a second event.
+ */
+export async function isClaimHeldBy(
+  claimPath: string,
+  instance: string
+): Promise<boolean> {
+  const claim = await readClaim(claimPath);
+  const owner = claim && parseClaimOwner(claim.content);
+  return owner?.process === identity.process && owner.instance === instance;
+}
diff --git a/packages/world-local/src/storage/claim-repair.child.mjs b/packages/world-local/src/storage/claim-repair.child.mjs
new file mode 100644
index 000000000..6d9113cde
--- /dev/null
+++ b/packages/world-local/src/storage/claim-repair.child.mjs
@@ -0,0 +1,63 @@
+// A second OS process for claim-repair.test.ts: it opens its own storage on
+// the parent's data directory, writes the one event the parent sends it, and
+// SIGKILLs itself at the given point of that write, which leaves the step or
+// wait claim without its event. It runs world-local's TypeScript source with
+// Node's type stripping, like in-band-fence.child.mjs.
+//
+// Kill points:
+//   claim:<part>    right after a claim file whose name has <part> is linked
+//   event:<type>    right before the <type> event file is written
+import fs from 'node:fs/promises';
+import { register } from 'node:module';
+import path from 'node:path';
+
+register(
+  `data:text/javascript,${encodeURIComponent(
+    'export async function resolve(s, c, n) { try { return await n(s, c); } catch (e) { if (/^\\.\\.?\\//.test(s) && s.endsWith(".js")) return n(s.slice(0, -3) + ".ts", c); throw e; } }'
+  )}`
+);
+
+// The parent forks this with `serialization: 'advanced'`, so the request's
+// Uint8Array and Date values arrive intact.
+const { dataDir, runId, request, killAt } = await new Promise((resolve) =>
+  process.once('message', resolve)
+);
+const [killKind, killWhat] = killAt.split(':');
+const kill = () => process.kill(process.pid, 'SIGKILL');
+
+const link = fs.link;
+fs.link = async (from, to) => {
+  await link(from, to);
+  const file = String(to);
+  if (
+    killKind === 'claim' &&
+    file.includes(`${path.sep}.locks${path.sep}`) &&
+    file.includes(killWhat)
+  ) {
+    kill();
+  }
+};
+const writeFile = fs.writeFile;
+fs.writeFile = async (file, data, options) => {
+  if (
+    killKind === 'event' &&
+    String(file).includes(`${path.sep}events${path.sep}`) &&
+    typeof data === 'string' &&
+    JSON.parse(data).eventType === killWhat
+  ) {
+    kill();
+  }
+  return writeFile(file, data, options);
+};
+
+const { createStorage } = await import('../storage.ts');
+const storage = createStorage(dataDir);
+try {
+  await storage.events.create(runId, request);
+  process.send({ status: 'written' }, () => process.exit(0));
+} catch (error) {
+  process.send(
+    { status: 'error', message: String(error?.message ?? error) },
+    () => process.exit(0)
+  );
+}
diff --git a/packages/world-local/src/storage/claim-repair.test.ts b/packages/world-local/src/storage/claim-repair.test.ts
new file mode 100644
index 000000000..df44faf27
--- /dev/null
+++ b/packages/world-local/src/storage/claim-repair.test.ts
@@ -0,0 +1,494 @@
+/**
+ * A step or wait change takes a claim file, writes its entity, then writes
+ * its event. A process killed between the claim and the event used to leave
+ * the run stuck for good: every later write of that change lost the claim and
+ * was refused, and nothing ever wrote the event.
+ *
+ * Each crash below is a real SIGKILL of a second process at the exact write.
+ * The next write must finish the change, exactly once. A claim whose writer
+ * may still be working must be left alone until it is
+ * CLAIM_ABANDONED_AFTER_MS old.
+ */
+import { fork } from 'node:child_process';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { EntityConflictError } from '@workflow/errors';
+import { SPEC_VERSION_CURRENT, type Storage } from '@workflow/world';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { createRun, updateRun } from '../test-helpers.js';
+import {
+  CLAIM_ABANDONED_AFTER_MS,
+  claimOwnerContent,
+  isClaimHeldBy,
+  takeOverAbandonedClaim,
+} from './claim-owner.js';
+import { createStorage } from './index.js';
+
+type EventRequest = Parameters<Storage['events']['create']>[1];
+
+// Parks this process's next `.terminal` claim write, so a test can let
+// another process finish the step and die between this write's validation
+// and its claim.
+const gate = vi.hoisted(() => ({
+  armed: false,
+  parked: () => {},
+  release: () => {},
+}));
+
+vi.mock('../fs.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../fs.js')>();
+  return {
+    ...actual,
+    writeExclusive: async (filePath: string, data: string) => {
+      if (gate.armed && filePath.endsWith('.terminal')) {
+        gate.armed = false;
+        await new Promise<void>((resolve) => {
+          gate.release = resolve;
+          gate.parked();
+        });
+      }
+      return actual.writeExclusive(filePath, data);
+    },
+  };
+});
+
+const SPEC = SPEC_VERSION_CURRENT;
+const input = new Uint8Array([1]);
+const requests = {
+  stepCreated: (id: string): EventRequest => ({
+    eventType: 'step_created',
+    specVersion: SPEC,
+    correlationId: id,
+    eventData: { stepName: 'step', input },
+  }),
+  lazyStepStarted: (id: string): EventRequest => ({
+    eventType: 'step_started',
+    specVersion: SPEC,
+    correlationId: id,
+    eventData: { stepName: 'step', input },
+  }),
+  stepStarted: (id: string): EventRequest => ({
+    eventType: 'step_started',
+    specVersion: SPEC,
+    correlationId: id,
+    eventData: { stepName: 'step' },
+  }),
+  // `mark` tells apart the payloads of two writers of the same step.
+  stepCompleted: (id: string, mark = 1): EventRequest => ({
+    eventType: 'step_completed',
+    specVersion: SPEC,
+    correlationId: id,
+    eventData: { stepName: 'step', result: new Uint8Array([mark]) },
+  }),
+  stepFailed: (id: string, mark = 1): EventRequest => ({
+    eventType: 'step_failed',
+    specVersion: SPEC,
+    correlationId: id,
+    eventData: { stepName: 'step', error: new Uint8Array([mark]) },
+  }),
+  waitCreated: (id: string): EventRequest => ({
+    eventType: 'wait_created',
+    specVersion: SPEC,
+    correlationId: id,
+    eventData: { resumeAt: new Date(0) },
+  }),
+  waitCompleted: (id: string): EventRequest => ({
+    eventType: 'wait_completed',
+    specVersion: SPEC,
+    correlationId: id,
+  }),
+};
+
+let testDir: string;
+let storage: Storage;
+let runId: string;
+
+beforeEach(async () => {
+  testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'wl-claim-repair-'));
+  storage = createStorage(testDir);
+  const run = await createRun(storage, {
+    deploymentId: 'dpl_test',
+    workflowName: 'workflow',
+    input,
+  });
+  runId = run.runId;
+  await updateRun(storage, runId, 'run_started');
+});
+
+afterEach(async () => {
+  await fs.rm(testDir, { recursive: true, force: true });
+});
+
+const childScript = fileURLToPath(
+  new URL('./claim-repair.child.mjs', import.meta.url)
+);
+
+/**
+ * Writes `request` from a second process that is SIGKILLed at `killAt` (see
+ * claim-repair.child.mjs), and returns that process's pid, now dead.
+ */
+async function writeAndKill(
+  request: EventRequest,
+  killAt: string
+): Promise<number> {
+  const child = fork(childScript, [], {
+    // Node's own type stripping, nothing inherited from the test runner.
+    execArgv: [],
+    serialization: 'advanced',
+    stdio: ['ignore', 'ignore', 'inherit', 'ipc'],
+  });
+  let answer: unknown;
+  child.on('message', (message) => {
+    answer = message;
+  });
+  const exited = new Promise<NodeJS.Signals | null>((resolve, reject) => {
+    child.once('exit', (_code, signal) => resolve(signal));
+    child.once('error', reject);
+  });
+  child.send({ dataDir: testDir, runId, request, killAt });
+  expect(await exited, `child answered ${JSON.stringify(answer)}`).toBe(
+    'SIGKILL'
+  );
+  return child.pid as number;
+}
+
+async function eventsOf(correlationId: string) {
+  const page = await createStorage(testDir).events.listByCorrelationId({
+    runId,
+    correlationId,
+    resolveData: 'all',
+  });
+  return page.data;
+}
+
+async function eventTypesOf(correlationId: string): Promise<string[]> {
+  return (await eventsOf(correlationId)).map((event) => event.eventType);
+}
+
+function stepClaim(stepId: string, kind: 'created' | 'terminal'): string {
+  return path.join(testDir, '.locks', 'steps', `${runId}-${stepId}.${kind}`);
+}
+
+function waitClaim(waitId: string, kind: 'created' | 'completed'): string {
+  return path.join(testDir, '.locks', 'waits', `${runId}-${waitId}.${kind}`);
+}
+
+async function ageClaim(claimPath: string): Promise<void> {
+  const past = new Date(Date.now() - CLAIM_ABANDONED_AFTER_MS - 1_000);
+  await fs.utimes(claimPath, past, past);
+}
+
+async function startStep(id: string): Promise<void> {
+  await storage.events.create(runId, requests.stepCreated(id));
+  await storage.events.create(runId, requests.stepStarted(id));
+}
+
+describe('a process killed after a claim and before its event', () => {
+  it.each([
+    ['after the claim', 'claim:.created'],
+    ['after the step entity', 'event:step_created'],
+  ])('a lazy step_started is finished by the next one (killed %s)', async (_, killAt) => {
+    await writeAndKill(requests.lazyStepStarted('s'), killAt);
+
+    const result = await storage.events.create(
+      runId,
+      requests.lazyStepStarted('s')
+    );
+
+    expect(result.stepCreated).toBe(true);
+    expect(result.step?.status).toBe('running');
+    expect(await eventTypesOf('s')).toEqual(['step_created', 'step_started']);
+    await expect(
+      storage.events.create(runId, requests.lazyStepStarted('s'))
+    ).rejects.toThrow(EntityConflictError);
+  });
+
+  it.each([
+    ['after the claim', 'claim:.created'],
+    ['after the step entity', 'event:step_created'],
+  ])('a step_created is finished by the next one (killed %s)', async (_, killAt) => {
+    await writeAndKill(requests.stepCreated('s'), killAt);
+
+    const result = await storage.events.create(
+      runId,
+      requests.stepCreated('s')
+    );
+
+    expect(result.step?.status).toBe('pending');
+    expect(await eventTypesOf('s')).toEqual(['step_created']);
+    await expect(
+      storage.events.create(runId, requests.stepCreated('s'))
+    ).rejects.toThrow(EntityConflictError);
+  });
+
+  it('a step_completed killed after the claim is finished by the next one', async () => {
+    await startStep('s');
+    await writeAndKill(requests.stepCompleted('s', 1), 'claim:.terminal');
+
+    const result = await storage.events.create(
+      runId,
+      requests.stepCompleted('s', 2)
+    );
+
+    expect(result.step?.status).toBe('completed');
+    expect(result.step?.output).toEqual(new Uint8Array([2]));
+    expect(await eventTypesOf('s')).toEqual([
+      'step_created',
+      'step_started',
+      'step_completed',
+    ]);
+  });
+
+  it.each([
+    ['step_completed', requests.stepCompleted, 'result'],
+    ['step_failed', requests.stepFailed, 'error'],
+  ] as const)('a %s killed after the step entity is written by the next step_started, from the saved step', async (eventType, terminal, field) => {
+    await startStep('s');
+    await writeAndKill(terminal('s', 1), `event:${eventType}`);
+
+    // The redelivered start is refused, as before: the step is finished.
+    await expect(
+      storage.events.create(runId, requests.stepStarted('s'))
+    ).rejects.toThrow('terminal state');
+
+    const events = await eventsOf('s');
+    expect(events.map((event) => event.eventType)).toEqual([
+      'step_created',
+      'step_started',
+      eventType,
+    ]);
+    const written = events[2] as { eventData?: Record<string, unknown> };
+    expect(written.eventData?.[field]).toEqual(new Uint8Array([1]));
+    // A later terminal write is refused, and adds nothing.
+    await expect(
+      storage.events.create(runId, terminal('s', 2))
+    ).rejects.toThrow(EntityConflictError);
+    expect(await eventTypesOf('s')).toHaveLength(3);
+  });
+
+  it.each([
+    ['after the claim', 'claim:.created'],
+    ['after the wait entity', 'event:wait_created'],
+  ])('a wait_created is finished by the next one (killed %s)', async (_, killAt) => {
+    await writeAndKill(requests.waitCreated('w'), killAt);
+
+    const result = await storage.events.create(
+      runId,
+      requests.waitCreated('w')
+    );
+
+    expect(result.wait?.status).toBe('waiting');
+    expect(await eventTypesOf('w')).toEqual(['wait_created']);
+  });
+
+  it.each([
+    ['after the claim', 'claim:.completed'],
+    ['after the wait entity', 'event:wait_completed'],
+  ])('a wait_completed is finished by the next one (killed %s)', async (_, killAt) => {
+    await storage.events.create(runId, requests.waitCreated('w'));
+    await writeAndKill(requests.waitCompleted('w'), killAt);
+
+    const result = await storage.events.create(
+      runId,
+      requests.waitCompleted('w')
+    );
+
+    expect(result.wait?.status).toBe('completed');
+    expect(await eventTypesOf('w')).toEqual(['wait_created', 'wait_completed']);
+    await expect(
+      storage.events.create(runId, requests.waitCompleted('w'))
+    ).rejects.toThrow('already completed');
+  });
+
+  it('a takeover cut short before it rewrote the claim is taken over in turn', async () => {
+    await startStep('s');
+    await writeAndKill(requests.stepCompleted('s', 1), 'claim:.terminal');
+    // The next writer takes the claim over and dies right after its takeover
+    // marker, before it rewrote the claim.
+    await writeAndKill(requests.stepCompleted('s', 2), 'claim:.takeover.');
+
+    const result = await storage.events.create(
+      runId,
+      requests.stepCompleted('s', 3)
+    );
+
+    expect(result.step?.output).toEqual(new Uint8Array([3]));
+    expect(await eventTypesOf('s')).toEqual([
+      'step_created',
+      'step_started',
+      'step_completed',
+    ]);
+  });
+
+  it('a step finished by a writer that died after this write read it keeps the saved result', async () => {
+    await startStep('s');
+    const parked = new Promise<void>((resolve) => {
+      gate.parked = resolve;
+    });
+    gate.armed = true;
+    // Reads the step as running, then waits at its claim.
+    const late = storage.events.create(runId, requests.stepCompleted('s', 2));
+    await parked;
+    // Meanwhile another process saves the step as completed and dies.
